#!/usr/bin/env python3
"""Suspend SteamOS when the TV/AVR switches away from this HDMI-CEC source."""

from __future__ import annotations

import asyncio
import logging
import os
import re
import subprocess
import time

try:
    from dbus_next.aio import MessageBus
except ImportError:
    MessageBus = None


BUS_NAME = "com.steampowered.CecDaemon1"
DEVICE_PATH = "/com/steampowered/CecDaemon1/Devices/Cec0"
DEVICE_INTERFACE = "com.steampowered.CecDaemon1.CecDevice1"
PROPERTIES_INTERFACE = "org.freedesktop.DBus.Properties"
LOCAL_SUSPEND_MARKER = "/run/steamos-cec-local-suspend"
DEFAULT_CONFIG = "/etc/steamos-cec-toolkit.conf"
DEFAULT_DELAY_SECONDS = 60

logging.basicConfig(level=logging.INFO, format="%(levelname)s: %(message)s")
LOG = logging.getLogger("steamos-cec-input-away-suspend")


def read_config(path: str = DEFAULT_CONFIG) -> dict[str, str]:
    config: dict[str, str] = {}
    try:
        with open(path, encoding="utf-8") as file:
            for raw_line in file:
                line = raw_line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                config[key.strip()] = value.strip().strip('"').strip("'")
    except FileNotFoundError:
        pass
    return config


CONFIG = read_config(os.environ.get("STEAMOS_CEC_CONFIG", DEFAULT_CONFIG))
STEAMOS_CEC_USER = CONFIG.get("STEAMOS_CEC_USER", "deck")


def user_home(user: str) -> str:
    home = os.path.expanduser("~" + user)
    if not home.startswith("/"):
        home = f"/home/{user}"
    return home


USER_CONFIG = f"{user_home(STEAMOS_CEC_USER)}/.config/steamos-cec-toolkit/config.conf"
CONFIG.update(read_config(USER_CONFIG))
INPUT_INACTIVE_SUSPEND_MARKER = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"),
    "steamos-cec-input-inactive-suspend",
)
INPUT_INACTIVE_SUSPEND_DELAY_SECONDS = max(
    5,
    int(
        float(
            CONFIG.get(
                "INPUT_INACTIVE_SUSPEND_DELAY_SECONDS",
                CONFIG.get("INPUT_AWAY_SUSPEND_DELAY_SECONDS", str(DEFAULT_DELAY_SECONDS)),
            )
        )
    ),
)
CEC_DEVICE = CONFIG.get("CEC_DEVICE", "/dev/cec0")
CEC_MONITOR_COMMAND = (
    "sudo",
    "-n",
    "/var/lib/steamos-cec-toolkit/steamos-cec-debug-monitor",
    "0",
)
_raw_opcodes = CONFIG.get("CEC_ACTIVE_SOURCE_OPCODES", "0x82:0x86")
if _raw_opcodes.strip() == "0x2f:0x33":
    _raw_opcodes = "0x82:0x86"
CEC_ACTIVE_SOURCE_OPCODES = {
    int(token, 16)
    for token in _raw_opcodes.replace(",", ":").split(":")
    if token
} | {0x80, 0x82, 0x86}
CEC_PHYSICAL_ADDRESS = CONFIG.get("CEC_PHYSICAL_ADDRESS", "")

MONITOR_HEADER_RE = re.compile(
    r"(?:Received from|Transmitted by)\b.*\((\d+) to (\d+)\):"
)


def own_logical_address() -> "int | None":
    if not os.path.exists(CEC_DEVICE):
        return None
    try:
        out = subprocess.run(
            ["cec-ctl", "--device", CEC_DEVICE, "-s", "--logical-address"],
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        ).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    match = re.search(r"\d+", out)
    return int(match.group(0)) if match else None


def local_suspend_in_progress() -> bool:
    try:
        return time.time() - os.stat(LOCAL_SUSPEND_MARKER).st_mtime < 30
    except FileNotFoundError:
        return False


async def suspend() -> None:
    if local_suspend_in_progress():
        LOG.info("Ignoring input-inactive suspend during local suspend/shutdown")
        return

    try:
        with open(INPUT_INACTIVE_SUSPEND_MARKER, "w", encoding="utf-8") as marker:
            marker.write(str(time.time()))
    except OSError as error:
        LOG.warning("Could not write input-inactive suspend marker: %s", error)

    process = await asyncio.create_subprocess_exec(
        "systemctl",
        "suspend",
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.STDOUT,
    )
    stdout, _ = await process.communicate()
    if process.returncode != 0:
        try:
            os.unlink(INPUT_INACTIVE_SUSPEND_MARKER)
        except FileNotFoundError:
            pass
        except OSError as error:
            LOG.warning("Could not remove input-inactive suspend marker: %s", error)
        LOG.warning("Suspend failed: %s", stdout.decode(errors="replace").strip())


async def delayed_suspend(state: dict[str, object]) -> None:
    delay = INPUT_INACTIVE_SUSPEND_DELAY_SECONDS
    LOG.info("CEC source inactive; suspending SteamOS in %ss if input does not return", delay)
    await asyncio.sleep(delay)
    if state.get("active"):
        LOG.info("CEC source became active again; input-inactive suspend cancelled")
        return
    LOG.info("CEC source still inactive after %ss; suspending SteamOS", delay)
    await suspend()


def schedule_suspend(state: dict[str, object]) -> None:
    if local_suspend_in_progress():
        LOG.info("Ignoring inactive CEC source during local suspend/shutdown")
        return
    task = state.get("task")
    if task is not None and not task.done():
        return
    state["task"] = asyncio.create_task(delayed_suspend(state))


def cancel_suspend(state: dict[str, object]) -> None:
    task = state.get("task")
    if task is not None and not task.done():
        task.cancel()
        LOG.info("CEC source active; input-inactive suspend cancelled")
    state["task"] = None


def apply_active(state: dict[str, object], active: bool) -> None:
    previous = bool(state.get("active"))
    if previous == active:
        return
    state["active"] = active
    LOG.info("CEC Active changed: %s -> %s", previous, active)
    if previous and not active:
        schedule_suspend(state)
    elif active:
        cancel_suspend(state)


async def monitor_cecd() -> None:
    bus = await MessageBus().connect()
    introspection = await bus.introspect(BUS_NAME, DEVICE_PATH)
    proxy = bus.get_proxy_object(BUS_NAME, DEVICE_PATH, introspection)
    properties = proxy.get_interface(PROPERTIES_INTERFACE)

    active_variant = await properties.call_get(DEVICE_INTERFACE, "Active")
    state: dict[str, object] = {
        "active": bool(active_variant.value),
        "task": None,
    }

    def properties_changed(interface_name, changed, _invalidated):
        if interface_name != DEVICE_INTERFACE or "Active" not in changed:
            return
        apply_active(state, bool(changed["Active"].value))

    properties.on_properties_changed(properties_changed)
    LOG.info(
        "Monitoring CEC source active state for input-inactive suspend; initial state=%s, delay=%ss",
        state["active"],
        INPUT_INACTIVE_SUSPEND_DELAY_SECONDS,
    )
    await asyncio.get_running_loop().create_future()


def parse_physical_address_bytes(addr: str) -> list[int] | None:
    if not addr:
        return None
    try:
        parts = [int(part, 16) for part in addr.split(".")]
    except ValueError:
        return None
    if len(parts) != 4 or any(part < 0 or part > 15 for part in parts):
        return None
    if parts == [15, 15, 15, 15]:
        return None
    return [(parts[0] << 4) | parts[1], (parts[2] << 4) | parts[3]]


def physical_address_payload() -> list[int] | None:
    if os.path.exists(CEC_DEVICE):
        try:
            out = subprocess.run(
                ["cec-ctl", "--device", CEC_DEVICE],
                capture_output=True,
                text=True,
                timeout=5,
                check=False,
            ).stdout
            for line in out.splitlines():
                if "Physical Address" in line:
                    candidate = line.split(":", 1)[-1].strip()
                    parsed = parse_physical_address_bytes(candidate)
                    if parsed is not None:
                        return parsed
                    break
        except (OSError, subprocess.TimeoutExpired):
            pass
    return parse_physical_address_bytes(CEC_PHYSICAL_ADDRESS)


async def monitor_raw() -> None:
    """Track whether our source is active by watching CEC traffic directly.

    Any <Active Source>/<Set Stream Path> message sent to a specific logical
    address tells us which source the TV activated; a broadcast one carries a
    physical address payload instead. Initial state is active so we never
    suspend on startup when nothing has been observed yet.
    """
    state: dict[str, object] = {"active": True, "task": None}
    warned_no_la = False
    monitor_cmd = list(CEC_MONITOR_COMMAND)
    while True:
        own_la = own_logical_address()
        if own_la is None:
            if not warned_no_la:
                LOG.warning("No logical address on %s; waiting for CEC adapter", CEC_DEVICE)
                warned_no_la = True
            await asyncio.sleep(10)
            continue
        warned_no_la = False
        own_physical = physical_address_payload()
        LOG.info(
            "Monitoring CEC source active state via cec-ctl raw monitor; own logical address=%s, initial state=%s, delay=%ss",
            own_la,
            state["active"],
            INPUT_INACTIVE_SUSPEND_DELAY_SECONDS,
        )
        started = time.time()
        process = await asyncio.create_subprocess_exec(
            *monitor_cmd,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.DEVNULL,
        )
        source = destination = None
        while True:
            line_bytes = await process.stdout.readline()
            if not line_bytes:
                break
            line = line_bytes.decode(errors="replace").rstrip("\n")
            match = MONITOR_HEADER_RE.search(line)
            if match:
                source, destination = int(match.group(1)), int(match.group(2))
                continue
            if source is None or not line.lstrip().startswith("Raw:"):
                continue
            raw_text = line.lstrip()[len("Raw:"):].split("(", 1)[0]
            tokens = raw_text.split()
            try:
                payload = [int(token, 16) for token in tokens]
            except ValueError:
                continue
            if len(payload) >= 2 and payload[1] in CEC_ACTIVE_SOURCE_OPCODES:
                opcode = payload[1]
                if destination == 15:
                    target_phys = (
                        payload[4:6]
                        if opcode == 0x80 and len(payload) >= 6
                        else payload[2:4]
                    )
                    if own_physical and len(target_phys) == 2 and target_phys == own_physical:
                        apply_active(state, True)
                    elif len(target_phys) == 2:
                        apply_active(state, False)
                    continue
                apply_active(state, destination == own_la)
        rc = await process.wait()
        if rc == 2 and monitor_cmd[-1] == "0":
            monitor_cmd[-1] = "5"
            continue
        if time.time() - started < 2:
            LOG.warning("cec-ctl monitor exited immediately; retrying")
            await asyncio.sleep(10)


async def main() -> None:
    if MessageBus is not None:
        try:
            await monitor_cecd()
            return
        except Exception as exc:
            LOG.warning(
                "SteamOS cecd D-Bus unavailable (%s); "
                "falling back to cec-ctl raw monitor" % exc
            )
    await monitor_raw()


if __name__ == "__main__":
    asyncio.run(main())
