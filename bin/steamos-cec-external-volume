#!/usr/bin/env python3
"""PipeWire ExternalVolume Varlink server backed by HDMI-CEC volume commands."""

from __future__ import annotations

import argparse
import json
import os
import queue
import socket
import subprocess
import sys
import threading
import traceback
from pathlib import Path
from typing import Any


SOCKET_FD = 3
DEFAULT_CONFIG = "/etc/steamos-cec-toolkit.conf"
DEFAULT_VOLUME_CMD = str(Path.home() / ".local/bin/steamos-cec-volume")

EXTERNAL_VOLUME_INTERFACE = """interface org.pipewire.ExternalVolume

method GetCapabilities(
        device: string
) -> ()

method ReadVolume(
        device: string,
        route: string
) -> ()

method WriteVolumeAbsolute(
        device: string,
        route: string,
        volume: float
) -> ()

method WriteVolumeRelative(
        device: string,
        route: string,
        step: float
) -> ()

method ReadMute(
        device: string,
        route: string
) -> ()

method WriteMuteValue(
        device: string,
        route: string,
        mute: bool
) -> ()

method WriteMuteToggle(
        device: string,
        route: string
) -> ()

error InvalidDevice()

error InvalidRoute()

error OperationUnsupported()
"""

SERVICE_INTERFACE = """interface org.varlink.service

method GetInfo() -> (
        vendor: string,
        product: string,
        version: string,
        url: string,
        interfaces: []string
)

method GetInterfaceDescription(
        interface: string
) -> (
        description: string
)

error InterfaceNotFound()
error MethodNotFound()
error MethodNotImplemented()
error InvalidParameter()
error PermissionDenied()
error ExpectedMore()
"""


def read_config(path: str) -> dict[str, str]:
    config: dict[str, str] = {}
    paths = [Path(path)]
    user_config = Path.home() / ".config/steamos-cec-toolkit/config.conf"
    if user_config not in paths:
        paths.append(user_config)
    for config_path in paths:
        try:
            with config_path.open(encoding="utf-8") as file:
                for raw_line in file:
                    line = raw_line.strip()
                    if not line or line.startswith("#") or "=" not in line:
                        continue
                    key, value = line.split("=", 1)
                    config[key.strip()] = value.strip().strip('"').strip("'")
        except FileNotFoundError:
            pass
    return config


def log(message: str) -> None:
    print(message, file=sys.stderr, flush=True)


class ClientGone(Exception):
    """Raised when a client disconnects before the reply is written."""


def send_reply(conn: socket.socket, obj: dict[str, Any]) -> None:
    data = json.dumps(obj, separators=(",", ":")).encode("utf-8") + b"\0"
    try:
        conn.sendall(data)
    except (BrokenPipeError, ConnectionResetError, OSError) as error:
        raise ClientGone(str(error)) from error


def send_error(
    conn: socket.socket,
    name: str,
    parameters: dict[str, Any] | None = None,
) -> None:
    send_reply(conn, {"error": name, "parameters": parameters or {}})


class VolumeWorker:
    def __init__(self, command: str) -> None:
        self.command = command
        self.cond = threading.Condition()
        self.pending_steps = 0
        self.pending_mute = False
        self.supports_batch_arg = True
        self.volume = 50.0
        self.volume_lock = threading.Lock()
        self.thread = threading.Thread(target=self._run, daemon=True)
        self.thread.start()

    def enqueue(self, action: str, count: int = 1) -> None:
        if count < 1:
            return
        with self.cond:
            if action == "mute":
                self.pending_mute = True
            elif action == "up":
                if self.pending_steps < 0:
                    self.pending_steps = count
                else:
                    self.pending_steps = min(self.pending_steps + count, 16)
            elif action == "down":
                if self.pending_steps > 0:
                    self.pending_steps = -count
                else:
                    self.pending_steps = max(self.pending_steps - count, -16)
            self.cond.notify()

    def set_volume(self, target: float) -> None:
        target = max(0.0, min(100.0, target))
        with self.volume_lock:
            delta = int(round(target - self.volume))
            self.volume = target
        if delta != 0:
            self.enqueue("up" if delta > 0 else "down", abs(delta))

    def get_volume(self) -> float:
        with self.volume_lock:
            return self.volume

    def _run_cmd(self, action: str, count: int = 1) -> None:
        cmd = [self.command, action]
        if count > 1 and self.supports_batch_arg:
            cmd.append(str(count))
        log(f"CEC volume action: {action} x{count}")
        result = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=10,
            check=False,
        )
        if result.returncode == 2 and count > 1 and self.supports_batch_arg:
            self.supports_batch_arg = False
            for _ in range(count):
                subprocess.run(
                    [self.command, action],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True,
                    timeout=8,
                    check=False,
                )
        elif result.returncode != 0:
            log(
                "CEC volume command failed "
                f"({result.returncode}): {result.stdout.strip()}"
            )

    def _run(self) -> None:
        while True:
            with self.cond:
                while not self.pending_mute and self.pending_steps == 0:
                    self.cond.wait()
                if self.pending_mute:
                    self.pending_mute = False
                    action = "mute"
                    batch = 1
                elif self.pending_steps > 0:
                    batch = min(self.pending_steps, 4)
                    self.pending_steps -= batch
                    action = "up"
                else:
                    batch = min(-self.pending_steps, 4)
                    self.pending_steps += batch
                    action = "down"
            try:
                self._run_cmd(action, batch)
            except Exception:
                traceback.print_exc(file=sys.stderr)


def service_info() -> dict[str, Any]:
    return {
        "parameters": {
            "vendor": "SteamOS CEC Toolkit",
            "product": "steamos-cec-external-volume",
            "version": "0.1.0",
            "url": "https://github.com/",
            "interfaces": [
                "org.varlink.service",
                "org.pipewire.ExternalVolume",
            ],
        }
    }


def capabilities(route: str) -> dict[str, Any]:
    routes = [route]
    for idx in range(8):
        candidate = f"hdmi-output-{idx}"
        if candidate not in routes:
            routes.append(candidate)
    return {
        "parameters": {
            "readVolume": False,
            "readBalance": False,
            "volumeRange": {
                "min": 0.0,
                "max": 100.0,
                "step": 1.0,
            },
            "writeVolumeAbsolute": False,
            "writeVolumeRelative": True,
            "writeVolumeRelativeStep": {
                "min": 1.0,
                "max": 1.0,
            },
            "writeBalance": False,
            "readMute": False,
            "writeMuteValue": False,
            "writeMuteToggle": True,
            "routes": routes,
        }
    }


class Server:
    def __init__(self, worker: VolumeWorker, route: str) -> None:
        self.worker = worker
        self.route = route

    def handle_call(self, conn: socket.socket, msg: dict[str, Any]) -> None:
        method = msg.get("method")
        params = msg.get("parameters") or {}

        log(f"varlink call: {method} {params}")

        if method == "org.varlink.service.GetInfo":
            send_reply(conn, service_info())
            return

        if method == "org.varlink.service.GetInterfaceDescription":
            iface = params.get("interface")
            if iface == "org.pipewire.ExternalVolume":
                send_reply(conn, {"parameters": {"description": EXTERNAL_VOLUME_INTERFACE}})
            elif iface == "org.varlink.service":
                send_reply(conn, {"parameters": {"description": SERVICE_INTERFACE}})
            else:
                send_error(conn, "org.varlink.service.InterfaceNotFound")
            return

        if method == "org.pipewire.ExternalVolume.GetCapabilities":
            send_reply(conn, capabilities(self.route))
            return

        if method == "org.pipewire.ExternalVolume.ReadVolume":
            send_error(conn, "org.pipewire.ExternalVolume.OperationUnsupported")
            return

        if method == "org.pipewire.ExternalVolume.WriteVolumeAbsolute":
            send_error(conn, "org.pipewire.ExternalVolume.OperationUnsupported")
            return

        if method == "org.pipewire.ExternalVolume.WriteVolumeRelative":
            try:
                step = float(params.get("step", 0.0))
            except (TypeError, ValueError):
                send_error(conn, "org.varlink.service.InvalidParameter")
                return

            if step > 0:
                self.worker.enqueue("up")
            elif step < 0:
                self.worker.enqueue("down")
            send_reply(conn, {"parameters": {}})
            return

        if method == "org.pipewire.ExternalVolume.ReadMute":
            send_error(conn, "org.pipewire.ExternalVolume.OperationUnsupported")
            return

        if method == "org.pipewire.ExternalVolume.WriteMuteValue":
            send_error(conn, "org.pipewire.ExternalVolume.OperationUnsupported")
            return

        if method == "org.pipewire.ExternalVolume.WriteMuteToggle":
            self.worker.enqueue("mute")
            send_reply(conn, {"parameters": {}})
            return

        send_error(conn, "org.varlink.service.MethodNotFound")


PACTL_BIN = "/usr/bin/pactl" if Path("/usr/bin/pactl").is_file() else "pactl"


def _lock_sink_unity_volume(sink_name: str, fix_vol: bool = True, fix_mute: bool = True) -> None:
    if fix_mute:
        subprocess.run(
            [PACTL_BIN, "set-sink-mute", sink_name, "0"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=3,
            check=False,
        )
    if fix_vol:
        subprocess.run(
            [PACTL_BIN, "set-sink-volume", sink_name, "100%"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=3,
            check=False,
        )


def _query_hdmi_sinks(hdmi_card_name: str) -> dict[str, tuple[int, bool]]:
    result = subprocess.run(
        [PACTL_BIN, "-f", "json", "list", "sinks"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        timeout=5,
        check=False,
    )
    if result.returncode != 0 or not result.stdout.strip():
        return {}
    try:
        sinks = json.loads(result.stdout)
    except json.JSONDecodeError:
        return {}
    if not isinstance(sinks, list):
        return {}

    matched: dict[str, tuple[int, bool]] = {}
    for sink in sinks:
        if not isinstance(sink, dict):
            continue
        name = str(sink.get("name", ""))
        props = sink.get("properties") or {}
        if not isinstance(props, dict):
            props = {}
        if str(props.get("device.volume.write-volume-updown", "true")).lower() == "false":
            continue
        device_name = str(props.get("device.name", ""))
        if hdmi_card_name and device_name == hdmi_card_name:
            is_match = True
        elif "hdmi" in name.lower():
            is_match = True
        else:
            is_match = False
        if not is_match:
            continue

        vol_obj = sink.get("volume") or {}
        perc_list: list[int] = []
        if isinstance(vol_obj, dict):
            for ch in vol_obj.values():
                if isinstance(ch, dict):
                    raw_pct = str(ch.get("value_percent", "")).strip().rstrip("%")
                    if raw_pct.isdigit():
                        perc_list.append(int(raw_pct))
        if not perc_list:
            continue
        avg_vol = int(round(sum(perc_list) / len(perc_list)))
        mute = bool(sink.get("mute", False))
        matched[name] = (avg_vol, mute)
    return matched


def monitor_pipewire_sinks(worker: VolumeWorker, config_path: str) -> None:
    """Keep HDMI sinks at 100% unity volume and translate direct sink volume edits to CEC steps."""
    import time

    while True:
        config = read_config(config_path)
        hdmi_card_name = config.get("HDMI_ALSA_CARD_NAME", "")
        initialized_sinks: set[str] = set()
        for sink_name, (vol, mute) in _query_hdmi_sinks(hdmi_card_name).items():
            if vol != 100 or mute:
                _lock_sink_unity_volume(sink_name, fix_vol=(vol != 100), fix_mute=mute)
            initialized_sinks.add(sink_name)

        try:
            proc = subprocess.Popen(
                [PACTL_BIN, "subscribe"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
            )
        except FileNotFoundError:
            return
        except Exception as error:
            log(f"pactl subscribe failed: {error}")
            time.sleep(5)
            continue

        try:
            assert proc.stdout is not None
            for line in proc.stdout:
                if " on sink " not in line:
                    continue
                current_state = _query_hdmi_sinks(hdmi_card_name)
                initialized_sinks.intersection_update(current_state.keys())
                for sink_name, (vol, mute) in current_state.items():
                    if sink_name not in initialized_sinks:
                        if vol != 100 or mute:
                            _lock_sink_unity_volume(sink_name, fix_vol=(vol != 100), fix_mute=mute)
                        initialized_sinks.add(sink_name)
                        continue
                    if mute:
                        worker.enqueue("mute")
                        _lock_sink_unity_volume(sink_name, fix_vol=False, fix_mute=True)
                    delta = vol - 100
                    if delta != 0:
                        try:
                            step_mult = float(config.get("CEC_VOLUME_STEP_MULTIPLIER", "0.6"))
                        except ValueError:
                            step_mult = 0.6
                        steps = max(1, min(int(round(abs(delta) * step_mult)), 10))
                        worker.enqueue("up" if delta > 0 else "down", steps)
                        _lock_sink_unity_volume(sink_name, fix_vol=True, fix_mute=False)
        except Exception:
            traceback.print_exc(file=sys.stderr)
        finally:
            try:
                proc.terminate()
                proc.wait(timeout=2)
            except Exception:
                pass
        time.sleep(2)


def serve_connection(conn: socket.socket, server: Server) -> None:
    with conn:
        buffer = b""
        while True:
            try:
                chunk = conn.recv(4096)
            except (ConnectionResetError, OSError):
                return
            if not chunk:
                return

            buffer += chunk
            while b"\0" in buffer:
                raw, buffer = buffer.split(b"\0", 1)
                if not raw:
                    continue
                try:
                    message = json.loads(raw.decode("utf-8"))
                    server.handle_call(conn, message)
                except ClientGone:
                    return
                except Exception:
                    traceback.print_exc(file=sys.stderr)
                    try:
                        send_error(conn, "org.varlink.service.InvalidParameter")
                    except ClientGone:
                        return


def activated_socket() -> socket.socket:
    if int(os.environ.get("LISTEN_FDS", "0")) < 1:
        raise RuntimeError("expected systemd socket activation on fd 3")
    sock = socket.socket(fileno=SOCKET_FD)
    sock.setblocking(True)
    return sock


def listen_socket(path: str) -> socket.socket:
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass

    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.bind(path)
    sock.listen()
    return sock


def serve(sock: socket.socket, server: Server) -> None:
    while True:
        try:
            conn, _ = sock.accept()
        except OSError:
            return
        thread = threading.Thread(
            target=serve_connection,
            args=(conn, server),
            daemon=True,
        )
        thread.start()


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", default=os.environ.get("STEAMOS_CEC_CONFIG", DEFAULT_CONFIG))
    parser.add_argument("--listen", help="bind a UNIX socket path instead of using systemd fd 3")
    parser.add_argument("--volume-cmd")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    config = read_config(args.config)
    volume_cmd = args.volume_cmd or config.get("EXTERNAL_VOLUME_COMMAND", DEFAULT_VOLUME_CMD)
    route = config.get("EXTERNAL_VOLUME_ROUTE", "hdmi-output-0")

    worker = VolumeWorker(volume_cmd)
    server = Server(worker, route)
    monitor_thread = threading.Thread(
        target=monitor_pipewire_sinks,
        args=(worker, args.config),
        daemon=True,
    )
    monitor_thread.start()

    try:
        if args.listen:
            sock = listen_socket(args.listen)
            log(f"SteamOS CEC ExternalVolume listening at {args.listen}")
        else:
            # The toolkit service uses a regular per-user socket on Arch/CachyOS.
            # Keep socket activation support for SteamOS installations.
            listen_path = os.environ.get("CEC_EXTERNAL_VOLUME_SOCKET")
            if listen_path:
                sock = listen_socket(listen_path)
                log(f"CEC ExternalVolume listening at {listen_path}")
            else:
                sock = activated_socket()
                log("CEC ExternalVolume started on systemd socket fd 3")
    except Exception as error:
        log(str(error))
        return 1

    with sock:
        serve(sock, server)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
