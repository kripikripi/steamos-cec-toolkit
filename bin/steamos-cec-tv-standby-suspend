#!/usr/bin/env python3
"""Suspend SteamOS when the TV broadcasts an HDMI-CEC standby command."""

from __future__ import annotations

import asyncio
import logging
import os
import re
import time

try:
    from dbus_next.aio import MessageBus
except ImportError:
    MessageBus = None


BUS_NAME = "com.steampowered.CecDaemon1"
DEVICE_PATH = "/com/steampowered/CecDaemon1/Devices/Cec0"
DEVICE_INTERFACE = "com.steampowered.CecDaemon1.CecDevice1"
LOCAL_SUSPEND_MARKER = "/run/steamos-cec-local-suspend"
DEFAULT_CONFIG = "/etc/steamos-cec-toolkit.conf"

logging.basicConfig(level=logging.INFO, format="%(levelname)s: %(message)s")
LOG = logging.getLogger("steamos-cec-tv-standby-suspend")


def read_config(path: str = DEFAULT_CONFIG) -> dict[str, str]:
    config: dict[str, str] = {}
    try:
        with open(path, encoding="utf-8") as file:
            for raw_line in file:
                line = raw_line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                config[key.strip()] = value.strip().strip('"').strip("'")
    except FileNotFoundError:
        pass
    return config


SYSTEM_CONFIG = read_config(os.environ.get("STEAMOS_CEC_CONFIG", DEFAULT_CONFIG))
STEAMOS_CEC_USER = SYSTEM_CONFIG.get("STEAMOS_CEC_USER", "deck")
_cec_user_home = os.path.expanduser("~" + STEAMOS_CEC_USER)
if not _cec_user_home.startswith("/"):
    _cec_user_home = f"/home/{STEAMOS_CEC_USER}"
USER_CONFIG = f"{_cec_user_home}/.config/steamos-cec-toolkit/config.conf"
CONFIG = {**SYSTEM_CONFIG, **read_config(USER_CONFIG)}
TV_LOGICAL_ADDRESS = int(CONFIG.get("TV_LOGICAL_ADDRESS", "0"), 0)
CEC_PLAYBACK_LOGICAL_ADDRESS = int(CONFIG.get("CEC_PLAYBACK_LOGICAL_ADDRESS", "4"), 0)
CEC_STANDBY_OPCODE = int(CONFIG.get("CEC_STANDBY_OPCODE", "0x36"), 0)
CEC_REPORT_POWER_STATUS_OPCODE = 0x90
CEC_DEVICE = CONFIG.get("CEC_DEVICE", "/dev/cec0")
CEC_MONITOR_COMMAND = (
    "sudo",
    "-n",
    "/var/lib/steamos-cec-toolkit/steamos-cec-debug-monitor",
    "0",
)

MONITOR_HEADER_RE = re.compile(
    r"(?:Received from|Transmitted by)\b.*\((\d+) to (\d+)\):"
)


def cec_device_exists() -> bool:
    return os.path.exists(CEC_DEVICE)


def local_suspend_in_progress() -> bool:
    try:
        return time.time() - os.stat(LOCAL_SUSPEND_MARKER).st_mtime < 15
    except FileNotFoundError:
        return False


async def suspend() -> None:
    process = await asyncio.create_subprocess_exec(
        "systemctl",
        "suspend",
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.STDOUT,
    )
    stdout, _ = await process.communicate()
    if process.returncode != 0:
        LOG.warning("Suspend failed: %s", stdout.decode(errors="replace").strip())


async def monitor_cecd() -> None:
    bus = await MessageBus().connect()
    introspection = await bus.introspect(BUS_NAME, DEVICE_PATH)
    proxy = bus.get_proxy_object(BUS_NAME, DEVICE_PATH, introspection)
    device = proxy.get_interface(DEVICE_INTERFACE)

    def received_message(source, destination, _timestamp, payload):
        if (
            source == TV_LOGICAL_ADDRESS
            and destination in {15, CEC_PLAYBACK_LOGICAL_ADDRESS}
            and payload
            and payload[0] == CEC_STANDBY_OPCODE
        ):
            if local_suspend_in_progress():
                LOG.info("Ignoring TV standby caused by local suspend")
                return
            LOG.info("TV broadcast standby; suspending SteamOS")
            asyncio.create_task(suspend())

    device.on_received_message(received_message)
    LOG.info("Monitoring HDMI-CEC TV standby broadcasts via cecd")
    await asyncio.get_running_loop().create_future()


async def monitor_raw() -> None:
    """Watch CEC traffic directly from the CEC device using cec-ctl (no SteamOS cecd).

    cec-ctl --monitor-all --show-raw prints a header line such as
    'Received from TV to all (0 to 15): ...' followed by a '\tRaw: 0x..' line.
    """
    warned_missing = False
    tv_power_was_on = False
    monitor_cmd = list(CEC_MONITOR_COMMAND)
    while True:
        if not cec_device_exists():
            if not warned_missing:
                LOG.error("No CEC device at %s and cecd is unavailable; waiting", CEC_DEVICE)
                warned_missing = True
            await asyncio.sleep(10)
            continue
        warned_missing = False
        LOG.info("Monitoring HDMI-CEC TV standby via cec-ctl raw monitor on %s", CEC_DEVICE)
        started = time.time()
        process = await asyncio.create_subprocess_exec(
            *monitor_cmd,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.DEVNULL,
        )
        source = destination = None
        while True:
            line_bytes = await process.stdout.readline()
            if not line_bytes:
                break
            line = line_bytes.decode(errors="replace").rstrip("\n")
            match = MONITOR_HEADER_RE.search(line)
            if match:
                source, destination = int(match.group(1)), int(match.group(2))
                continue
            if source is None or not line.lstrip().startswith("Raw:"):
                continue
            raw_text = line.lstrip()[len("Raw:"):].split("(", 1)[0]
            tokens = raw_text.split()
            try:
                payload = [int(token, 16) for token in tokens]
            except ValueError:
                continue
            if source == TV_LOGICAL_ADDRESS and len(payload) >= 2:
                opcode = payload[1]
                if destination in {15, CEC_PLAYBACK_LOGICAL_ADDRESS} and opcode == CEC_STANDBY_OPCODE:
                    tv_power_was_on = False
                    if local_suspend_in_progress():
                        LOG.info("Ignoring TV standby caused by local suspend")
                        continue
                    LOG.info("TV broadcast standby; suspending (raw monitor)")
                    asyncio.create_task(suspend())
                elif opcode == CEC_REPORT_POWER_STATUS_OPCODE and len(payload) >= 3:
                    pwr_state = payload[2]
                    if pwr_state == 0x00:
                        tv_power_was_on = True
                    elif pwr_state in {0x01, 0x03} and tv_power_was_on:
                        tv_power_was_on = False
                        if local_suspend_in_progress():
                            LOG.info("Ignoring TV power standby report caused by local suspend")
                            continue
                        LOG.info("TV power transitioned to standby; suspending (raw monitor)")
                        asyncio.create_task(suspend())
        rc = await process.wait()
        if rc == 2 and monitor_cmd[-1] == "0":
            monitor_cmd[-1] = "5"
            continue
        if time.time() - started < 2:
            LOG.warning("cec-ctl monitor exited immediately; pausing before retry")
            await asyncio.sleep(10)


async def main() -> None:
    if MessageBus is not None:
        try:
            await monitor_cecd()
            return
        except Exception as exc:
            LOG.warning(
                "SteamOS cecd D-Bus unavailable (%s); "
                "falling back to cec-ctl raw monitor" % exc
            )
    await monitor_raw()


if __name__ == "__main__":
    asyncio.run(main())
