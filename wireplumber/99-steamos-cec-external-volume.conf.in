# CEC Toolkit: enable PipeWire ExternalVolume for HDMI CEC.

context.properties = {
  support.varlink = true
}

monitor.alsa.rules = [
  {
    matches = [
      {
        device.name = "@HDMI_ALSA_CARD_NAME@"
      }
    ]
    actions = {
      update-props = {
        device.description = "HDMI / DisplayPort"
        api.acp.disable-pro-audio = true
        device.routes.default-sink-volume = 1.0
        api.alsa.external-volume-control = "unix:@CEC_EXTERNAL_VOLUME_SOCKET@"
        steamos.supports-hdmi-cec = true
        cec-toolkit.supports-hdmi-cec = true
      }
    }
  },
  {
    matches = [
      {
        node.name = "~alsa_output.pci-.*hdmi.*"
      }
    ]
    actions = {
      update-props = {
        session.suspend-timeout-seconds = 3600
        device.volume.read-volume = false
        device.volume.write-volume-value = false
        device.volume.write-volume-updown = true
        device.volume.read-mute = false
        device.volume.write-mute-value = false
        device.volume.write-mute-toggle = true
      }
    }
  }
]

wireplumber.settings.schema = {
  monitor.alsa.enable-external-volume-control = {
    description = "Whether to enable external HDMI-CEC volume control"
    type = "bool"
    default = true
  }
}

wireplumber.settings = {
  monitor.alsa.enable-external-volume-control = true
}
